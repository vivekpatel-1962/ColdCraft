# Copy to .env.local (gitignored). Vite exposes only VITE_-prefixed vars.

# Backend origin. Omit for local dev (defaults to http://localhost:8100).
VITE_API_BASE=http://localhost:8100

# Clerk publishable key (Clerk dashboard -> API Keys -> Publishable key).
# Leave EMPTY for local dev with no auth: the app renders straight through and the
# backend uses its single local dev user. Set it to require sign-in per user.
VITE_CLERK_PUBLISHABLE_KEY=
