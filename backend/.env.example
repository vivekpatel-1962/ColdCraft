# Copy this file to .env and fill in your keys. .env is gitignored.

# ============================================================================
# LLM provider
# ============================================================================
# Primary provider — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ...or multiple keys for rotation (quota is per-key/day; adapter rotates on 429).
# Comma-separated; takes precedence over GEMINI_API_KEY if both are set:
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_MODEL_JUDGMENT=gemini-flash-latest
GEMINI_MODEL_EXTRACTION=gemini-flash-lite-latest

# Multi-tenant guard: judgment-model quota (matcher+planner+writer, 3 calls/email)
# is a SHARED pool across every user — 20 req/day per Gemini project. This caps how
# many emails any one user can generate per day so one account can't exhaust the
# platform's whole daily budget. Resets at midnight Pacific, same as Gemini's quota.
DAILY_EMAIL_LIMIT_PER_USER=3

# Optional fallback provider (OpenAI-compatible) — leave empty to disable.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# ============================================================================
# Database — MongoDB (Atlas)
# ============================================================================
# Atlas: create a free M0 cluster, add a database user, allow your IP (or
# 0.0.0.0/0 for a hosted backend), then copy the "Connect your application"
# string here. The db name after the host (or MONGODB_DB) is used.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coldcraft

# ============================================================================
# Auth — Clerk (https://dashboard.clerk.com)
# ============================================================================
# Leave CLERK_ISSUER EMPTY for local dev: every request is attributed to a single
# local user, so the app + CLI scripts work exactly like the old single-user tool.
# Set it in production to enforce real per-user auth.
#
# CLERK_ISSUER is your Clerk "Frontend API URL" (Clerk dashboard -> API Keys ->
# Show API URLs -> "Frontend API URL"), e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Optional — only needed if you use Clerk's backend SDK features later.
CLERK_SECRET_KEY=
# Optional override; defaults to CLERK_ISSUER + /.well-known/jwks.json
# CLERK_JWKS_URL=

# ============================================================================
# URLs / CORS
# ============================================================================
# Public origin of THIS backend (used to build the Gmail OAuth redirect URI).
BACKEND_URL=http://localhost:8110
# Frontend origin (users return here after connecting Gmail).
APP_URL=http://localhost:5173
# Comma-separated allowed origins. Defaults to localhost:5173 + APP_URL if empty.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
# Secret that signs the Gmail OAuth `state` token. Set a long random value in prod.
OAUTH_STATE_SECRET=

# ============================================================================
# Sending — Gmail (per-user OAuth)
# ============================================================================
# Web OAuth client for the in-app "Connect Gmail" button:
#   Google Cloud -> APIs & Services -> Credentials -> Create credentials ->
#   OAuth client ID -> Application type: Web application.
#   Add Authorized redirect URI:  {BACKEND_URL}/api/gmail/callback
#   (e.g. http://localhost:8110/api/gmail/callback and your prod URL).
#   Enable the Gmail API; add users as Test users until the app is verified.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Legacy Desktop-app OAuth (only used by the local CLI: python -m scripts.gmail_auth).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=.gmail_token.json

# Where per-user uploaded resumes are stored (one subdir per user id).
RESUMES_DIR=../data/resumes
# Optional single-user resume override/fallback (legacy).
RESUME_PATH=

# Optional GitHub token to raise the public-API rate limit during repo enrichment.
GITHUB_TOKEN=
