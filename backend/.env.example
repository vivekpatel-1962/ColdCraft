# Copy this file to .env and fill in your keys. .env is gitignored.

# Primary provider — free tier: https://aistudio.google.com/apikey
# Single key:
GEMINI_API_KEY=
# ...or multiple keys for rotation (quota is per-key/day; adapter rotates on 429).
# Comma-separated; takes precedence over GEMINI_API_KEY if both are set:
# GEMINI_API_KEYS=key1,key2,key3

# Model routing (aliases resolve to the latest free-tier models)
GEMINI_MODEL_JUDGMENT=gemini-flash-latest
GEMINI_MODEL_EXTRACTION=gemini-flash-lite-latest

# Optional fallback provider (OpenAI-compatible) — leave empty to disable.
# e.g. Groq: https://console.groq.com  base_url=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# SQLite database location (relative to repo root)
DATABASE_PATH=../data/coldmail.db

# ---- Sending (Gmail API) ----
# OAuth client secret JSON (Google Cloud -> Credentials -> OAuth client ID ->
# Desktop app). Enable the Gmail API on that project and add the sending address
# as a Test user on the consent screen. Then run:  python -m scripts.gmail_auth
# The account you pick in the browser is the account mail is sent from — it does
# not have to be the address in your resume.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=.gmail_token.json

# Resume PDF to attach. Recorded automatically when you run scripts.analyze_resume;
# set this only to override, or for a profile analyzed before that was tracked.
RESUME_PATH=
